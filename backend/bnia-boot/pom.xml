<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.bnia</groupId>
        <artifactId>bnia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bnia-boot</artifactId>
    <name>BNIA : boot</name>
    <description>Point d'entrée : assemble les contextes. Câblage, configuration, transactions, migration Flyway, tests d'intégration et ArchUnit (ADR-002, ADR-014).</description>

    <dependencies>
        <!-- Le module -infra de chaque contexte, qui apporte son -core (ADR-014) : en ajouter un ici à chaque nouveau contexte. -->
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-systeme-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-referentiels-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-operateurs-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-authentification-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-declarations-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-facturation-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-messagerie-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-notifications-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-contratsarmagnac-infra</artifactId>
        </dependency>
        <!-- Migration Flyway unique, commune à tous les contextes (ADR-005). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Redémarrage à chaud en dev ; absent du jar exécutable (optional), inactif en production. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                </configuration>
            </plugin>
            <!-- Les *IT tournent en phase integration-test (./mvnw verify), Docker requis (ADR-003). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Front embarqué dans le jar (déploiement, docs/deploiement-scalingo.md) : build de frontend/ avec
             Node et pnpm téléchargés, puis copie de frontend/dist dans static/, servi par FrontConfiguration. -->
        <profile>
            <id>front</id>
            <properties>
                <front.dir>${project.basedir}/../../frontend</front.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>1.15.1</version>
                        <configuration>
                            <workingDirectory>${front.dir}</workingDirectory>
                            <installDirectory>${project.build.directory}</installDirectory>
                            <nodeVersion>v22.16.0</nodeVersion>
                            <pnpmVersion>10.12.1</pnpmVersion>
                        </configuration>
                        <executions>
                            <execution>
                                <id>installer-node-et-pnpm</id>
                                <goals>
                                    <goal>install-node-and-pnpm</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>pnpm-install</id>
                                <goals>
                                    <goal>pnpm</goal>
                                </goals>
                                <configuration>
                                    <arguments>install --frozen-lockfile</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pnpm-build</id>
                                <goals>
                                    <goal>pnpm</goal>
                                </goals>
                                <configuration>
                                    <arguments>build</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copier-le-front</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${front.dir}/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
