<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>fr.bnia</groupId>
    <artifactId>bnia-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>BNIA : plateforme métier</name>

    <!-- Un module parent par bounded context, avec deux sous-modules : bnia-<contexte>-core (domain,
         application, Java pur) et bnia-<contexte>-infra (adapters) (ADR-014). -->
    <modules>
        <module>bnia-commun</module>
        <module>bnia-systeme</module>
        <module>bnia-referentiels</module>
        <module>bnia-operateurs</module>
        <module>bnia-authentification</module>
        <module>bnia-boot</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>3.1.1</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
        <fastexcel.version>0.19.0</fastexcel.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-commun-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-commun-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-systeme-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-systeme-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-referentiels-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-referentiels-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-operateurs-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-operateurs-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-authentification-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.bnia</groupId>
                <artifactId>bnia-authentification-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dhatim</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dhatim</groupId>
                <artifactId>fastexcel-reader</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Règles communes à tous les modules (ADR-002, ADR-014). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>socle</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                                <bannedDependencies>
                                    <message>Seul bnia-boot assemble l'application : aucun module n'en dépend (ADR-014).</message>
                                    <excludes>
                                        <exclude>fr.bnia:bnia-boot</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
