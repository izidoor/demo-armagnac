<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.bnia</groupId>
        <artifactId>bnia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bnia-application</artifactId>
    <name>BNIA : application</name>
    <description>Cas d'usage (@UseCase) et ports. Dépend du domaine uniquement (ADR-002).</description>

    <dependencies>
        <dependency>
            <groupId>fr.bnia</groupId>
            <artifactId>bnia-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>application-sans-framework</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>bnia-application ne dépend que de bnia-domain : ni framework, ni persistance, ni adapter (ADR-002).</message>
                                    <excludes>
                                        <exclude>fr.bnia</exclude>
                                        <exclude>org.springframework*</exclude>
                                        <exclude>jakarta.*</exclude>
                                        <exclude>javax.*</exclude>
                                        <exclude>com.fasterxml.jackson*</exclude>
                                        <exclude>tools.jackson*</exclude>
                                        <exclude>org.hibernate*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>fr.bnia:bnia-domain</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
