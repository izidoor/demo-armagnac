{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Back-office BNIA et portail opérateur",
    "title" : "API BNIA",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Sonde technique",
    "name" : "systeme"
  }, {
    "description" : "Référentiel : zones commerciales, continents (C.10.4)",
    "name" : "zones-commerciales"
  } ],
  "paths" : {
    "/api/referentiels/zones-commerciales" : {
      "get" : {
        "operationId" : "listerZonesCommerciales",
        "parameters" : [ {
          "description" : "Absent : actives et inactives",
          "in" : "query",
          "name" : "actif",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "description" : "Texte cherché dans le code ou le libellé",
          "in" : "query",
          "name" : "recherche",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ValeurSimple"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Lister les valeurs, triées par libellé",
        "tags" : [ "zones-commerciales" ]
      },
      "post" : {
        "operationId" : "creerZoneCommerciale",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreationValeurSimple"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValeurSimple"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Créer une valeur (RG-REF-01, RG-REF-03)",
        "tags" : [ "zones-commerciales" ]
      }
    },
    "/api/referentiels/zones-commerciales/{code}" : {
      "get" : {
        "operationId" : "consulterZoneCommerciale",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValeurSimple"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Consulter une valeur, active ou non",
        "tags" : [ "zones-commerciales" ]
      },
      "put" : {
        "operationId" : "modifierZoneCommerciale",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ModificationValeurSimple"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValeurSimple"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Modifier le libellé ; le code est immuable (RG-REF-02)",
        "tags" : [ "zones-commerciales" ]
      }
    },
    "/api/referentiels/zones-commerciales/{code}/desactivation" : {
      "post" : {
        "operationId" : "desactiverZoneCommerciale",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValeurSimple"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Désactiver une valeur (RG-REF-04)",
        "tags" : [ "zones-commerciales" ]
      }
    },
    "/api/referentiels/zones-commerciales/{code}/reactivation" : {
      "post" : {
        "operationId" : "reactiverZoneCommerciale",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValeurSimple"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Réactiver une valeur (RG-REF-04)",
        "tags" : [ "zones-commerciales" ]
      }
    },
    "/api/systeme/info" : {
      "get" : {
        "operationId" : "consulterInfoSysteme",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InfoSysteme"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Version de l'application et de la base",
        "tags" : [ "systeme" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreationValeurSimple" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "EUR"
          },
          "libelle" : {
            "type" : "string",
            "example" : "Europe"
          }
        },
        "required" : [ "code", "libelle" ]
      },
      "InfoSysteme" : {
        "type" : "object",
        "description" : "Identification de l'application et de la base qui la sert",
        "properties" : {
          "application" : {
            "type" : "string",
            "example" : "BNIA"
          },
          "version" : {
            "type" : "string",
            "example" : "0.1.0-SNAPSHOT"
          },
          "versionBase" : {
            "type" : "string",
            "example" : "PostgreSQL 18.0"
          }
        },
        "required" : [ "application", "version", "versionBase" ]
      },
      "ModificationValeurSimple" : {
        "type" : "object",
        "description" : "Le code est immuable (RG-REF-02) : seul le libellé change",
        "properties" : {
          "libelle" : {
            "type" : "string",
            "example" : "Europe"
          }
        },
        "required" : [ "libelle" ]
      },
      "ValeurSimple" : {
        "type" : "object",
        "description" : "Valeur d'une liste de référentiel",
        "properties" : {
          "actif" : {
            "type" : "boolean"
          },
          "code" : {
            "type" : "string",
            "example" : "EUR"
          },
          "libelle" : {
            "type" : "string",
            "example" : "Europe"
          }
        },
        "required" : [ "actif", "code", "libelle" ]
      }
    }
  }
}
